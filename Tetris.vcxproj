  <!--
    Raylib location.
    RAYLIB_PATH may come from the environment or /p:RAYLIB_PATH=...
    When unset, the vendored copy under third_party\raylib is used.
    A raylib source tree (src\raylib.h present) uses its VS2022 DLL build outputs.
  -->
  <PropertyGroup Label="Raylib">
    <RAYLIB_PATH Condition="'$(RAYLIB_PATH)' == ''">$(ProjectDir)third_party\raylib</RAYLIB_PATH>
    <RaylibIsSourceTree Condition="Exists('$(RAYLIB_PATH)\src\raylib.h')">true</RaylibIsSourceTree>
    <RaylibIncludeDir Condition="'$(RaylibIsSourceTree)' == 'true'">$(RAYLIB_PATH)\src</RaylibIncludeDir>
    <RaylibIncludeDir Condition="'$(RaylibIncludeDir)' == ''">$(RAYLIB_PATH)\include</RaylibIncludeDir>
    <RaylibLibDir Condition="'$(RaylibIsSourceTree)' == 'true' and Exists('$(RAYLIB_PATH)\projects\VS2022\build\raylib\bin\$(Platform)\$(Configuration).DLL\raylib.lib')">$(RAYLIB_PATH)\projects\VS2022\build\raylib\bin\$(Platform)\$(Configuration).DLL</RaylibLibDir>
    <RaylibLibDir Condition="'$(RaylibIsSourceTree)' == 'true' and '$(RaylibLibDir)' == '' and Exists('$(RAYLIB_PATH)\projects\VS2022\build\raylib\bin\$(Platform)\Debug.DLL\raylib.lib')">$(RAYLIB_PATH)\projects\VS2022\build\raylib\bin\$(Platform)\Debug.DLL</RaylibLibDir>
    <RaylibLibDir Condition="'$(RaylibIsSourceTree)' == 'true' and '$(RaylibLibDir)' == ''">$(RAYLIB_PATH)\projects\VS2022\build\raylib\bin\$(Platform)\$(Configuration).DLL</RaylibLibDir>
    <RaylibLibDir Condition="'$(RaylibLibDir)' == ''">$(RAYLIB_PATH)\lib\$(Platform)</RaylibLibDir>
  </PropertyGroup>
